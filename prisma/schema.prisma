datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String
  role        Role     @default(VIEWER)
  totpSecret  String?
  totpEnabled Boolean  @default(false)
  backupCodes String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user")
}

model DataSource {
  id         Int        @id @default(autoincrement())
  sourceType Int
  month      Int
  year       Int
  createdAt  DateTime   @default(now())
  employees  Employee[]

  @@unique([sourceType, month, year])
  @@map("datasource")
}

model Employee {
  id           Int         @id @default(autoincrement())
  employeeId   String      @unique
  dataSourceId Int?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  nameTh       String
  nameEn       String?
  position     String?
  level        String?
  department   String?
  bureau       String?
  startDate    DateTime?
  endDate      DateTime?
  receivedDate DateTime?
  fmis         String?
  fmisDate     DateTime?
  eMeeting     String?
  eMeetingDate DateTime?
  software      String?
  softwareDate  DateTime?
  phonebook     String?
  phonebookDate DateTime?
  email         String?
  createdBy    String
  updatedBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AuditLog[]

  @@map("employee")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  employeeId    String
  action        String
  changedFields Json?
  adminUser     String
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@map("auditlog")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VIEWER
}
