datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  username    String?  @unique(map: "User_username_key") @db.VarChar(50)
  email       String   @unique(map: "User_email_key")
  password    String
  role        Role     @default(VIEWER)
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  backupCodes       String?  @db.Text
  notifyOnImport    Boolean  @default(false)
  notifyOnRetire    Boolean  @default(false)
  permissionsConfigured Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  permissions       UserPermission[]
  securityActions   SecurityAudit[] @relation("SecurityAuditActor")
  securityEvents    SecurityAudit[] @relation("SecurityAuditTarget")

  @@map("user")
}

model SecurityAudit {
  id           Int      @id @default(autoincrement())
  action       String   @db.VarChar(100)
  actorUserId  String?
  targetUserId String?
  actorEmail   String   @db.VarChar(191)
  targetEmail  String   @db.VarChar(191)
  ipAddress    String?  @db.VarChar(100)
  createdAt    DateTime @default(now())
  actor        User?    @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?    @relation("SecurityAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("security_audit")
}

model UserPermission {
  userId     String
  permission String   @db.VarChar(100)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@index([permission])
  @@map("user_permission")
}

model DataSource {
  id         Int        @id @default(autoincrement())
  sourceType Int
  month      Int
  year       Int
  createdAt  DateTime   @default(now())
  employees  Employee[]

  @@unique([sourceType, month, year], map: "DataSource_sourceType_month_year_key")
  @@map("datasource")
}

model Employee {
  id           Int         @id @default(autoincrement())
  employeeId   String      @unique(map: "Employee_employeeId_key")
  dataSourceId Int?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull, map: "Employee_dataSourceId_fkey")
  nameTh       String
  nameEn       String?
  position     String?
  level        String?
  department   String?
  bureau       String?
  startDate    DateTime?
  endDate      DateTime?
  receivedDate DateTime?
  fmis         String?
  fmisDate     DateTime?
  eMeeting     String?
  eMeetingDate DateTime?
  software      String?
  softwareDate  DateTime?
  phonebook     String?
  phonebookDate DateTime?
  email         String?
  createdBy    String
  updatedBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AuditLog[]

  @@map("employee")
  @@index([createdAt])
}

model IntegrationClient {
  id                  String              @id @default(cuid())
  name                String              @unique @db.VarChar(191)
  keyHash             String              @unique @db.VarChar(64)
  keyPrefix           String              @db.VarChar(24)
  isActive             Boolean             @default(true)
  expiresAt            DateTime?
  ipAllowlist          Json?
  allowFullSync        Boolean             @default(true)
  fullSyncCompletedAt  DateTime?
  fullSyncRequestId    String?              @db.VarChar(64)
  lastUsedAt           DateTime?
  createdBy            String               @db.VarChar(191)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  logs                 IntegrationApiLog[]
  audits               IntegrationClientAudit[]

  @@index([isActive])
  @@map("integration_client")
}

model IntegrationClientAudit {
  id          Int               @id @default(autoincrement())
  clientId    String?
  clientName  String            @db.VarChar(191)
  action      String            @db.VarChar(100)
  actorEmail  String            @db.VarChar(191)
  ipAddress   String?           @db.VarChar(100)
  details     Json?
  createdAt   DateTime          @default(now())
  client      IntegrationClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("integration_client_audit")
}

model IntegrationApiLog {
  id            Int                     @id @default(autoincrement())
  requestId     String                  @unique @db.VarChar(64)
  clientId      String?
  clientName    String                  @db.VarChar(191)
  endpoint      String                  @db.VarChar(255)
  method        String                  @db.VarChar(10)
  recordedFrom  DateTime?
  recordedTo    DateTime?
  resultCount   Int                     @default(0)
  statusCode    Int
  ipAddress     String?                 @db.VarChar(100)
  durationMs    Int
  errorCode     String?                 @db.VarChar(100)
  createdAt     DateTime                @default(now())
  client        IntegrationClient?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items         IntegrationApiLogItem[]

  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("integration_api_log")
}

model IntegrationApiLogItem {
  apiLogId   Int
  employeeId String @db.VarChar(191)
  apiLog     IntegrationApiLog @relation(fields: [apiLogId], references: [id], onDelete: Cascade)

  @@id([apiLogId, employeeId])
  @@index([employeeId])
  @@map("integration_api_log_item")
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  employeeId    String
  action        String
  changedFields Json?
  adminUser     String
  source        AuditSource @default(MANUAL)
  fileName      String?
  importBatchId String?
  createdAt     DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, map: "AuditLog_employeeId_fkey")

  @@map("auditlog")
}

enum AuditSource {
  MANUAL
  IMPORT
}

model SystemSetting {
  key   String @id
  value String @db.Text

  @@map("system_setting")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VIEWER
}
