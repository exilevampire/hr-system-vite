datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String
  role        Role     @default(VIEWER)
  totpSecret  String?
  totpEnabled Boolean  @default(false)
  backupCodes String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id           Int       @id @default(autoincrement())
  employeeId   String    @unique
  sourceFile   String?
  nameTh       String
  nameEn       String?
  position     String?
  level        String?
  department   String?
  bureau       String?
  startDate    DateTime?
  endDate      DateTime?
  receivedDate DateTime?
  fmis         String?
  fmisDate     DateTime?
  eMeeting     String?
  eMeetingDate DateTime?
  website      String?
  websiteDate  DateTime?
  phone3cx     String?
  phone3cxDate DateTime?
  intranet     String?
  intranetDate DateTime?
  createdBy    String
  updatedBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AuditLog[]
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  employeeId    String
  action        String
  changedFields Json?
  adminUser     String
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  VIEWER
}
