datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique(map: "User_email_key")
  password    String
  role        Role     @default(VIEWER)
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  backupCodes       String?  @db.Text
  notifyOnImport    Boolean  @default(false)
  notifyOnRetire    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user")
}

model DataSource {
  id         Int        @id @default(autoincrement())
  sourceType Int
  month      Int
  year       Int
  createdAt  DateTime   @default(now())
  employees  Employee[]

  @@unique([sourceType, month, year], map: "DataSource_sourceType_month_year_key")
  @@map("datasource")
}

model Employee {
  id           Int         @id @default(autoincrement())
  employeeId   String      @unique(map: "Employee_employeeId_key")
  dataSourceId Int?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull, map: "Employee_dataSourceId_fkey")
  nameTh       String
  nameEn       String?
  position     String?
  level        String?
  department   String?
  bureau       String?
  startDate    DateTime?
  endDate      DateTime?
  receivedDate DateTime?
  fmis         String?
  fmisDate     DateTime?
  eMeeting     String?
  eMeetingDate DateTime?
  software      String?
  softwareDate  DateTime?
  phonebook     String?
  phonebookDate DateTime?
  email         String?
  createdBy    String
  updatedBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AuditLog[]

  @@map("employee")
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  employeeId    String
  action        String
  changedFields Json?
  adminUser     String
  source        AuditSource @default(MANUAL)
  fileName      String?
  importBatchId String?
  createdAt     DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, map: "AuditLog_employeeId_fkey")

  @@map("auditlog")
}

enum AuditSource {
  MANUAL
  IMPORT
}

model SystemSetting {
  key   String @id
  value String @db.Text

  @@map("system_setting")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VIEWER
}
